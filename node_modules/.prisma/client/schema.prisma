datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tournament {
  id        String   @id // ID extraído do VLR
  name      String
  status    String // upcoming, ongoing, completed
  prizePool String?
  dates     String?
  region    String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches   Match[]
}

model Team {
  id           String   @id @default(uuid())
  name         String   @unique
  logoUrl      String?
  players      Player[]
  team1Matches Match[]  @relation("Team1Matches")
  team2Matches Match[]  @relation("Team2Matches")
}

model Player {
  id       String             @id @default(uuid())
  nickname String             @unique
  teamId   String?
  team     Team?              @relation(fields: [teamId], references: [id])
  stats    PlayerMatchStats[]
}

model Match {
  id           String             @id // ID do VLR
  tournamentId String?
  tournament   Tournament?        @relation(fields: [tournamentId], references: [id])
  team1Id      String
  team1        Team               @relation("Team1Matches", fields: [team1Id], references: [id])
  team2Id      String
  team2        Team               @relation("Team2Matches", fields: [team2Id], references: [id])
  score1       Int                @default(0)
  score2       Int                @default(0)
  status       String // live, completed, upcoming
  roundInfo    String?
  maps         MatchMap[]
  playerStats  PlayerMatchStats[]
  updatedAt    DateTime           @updatedAt
}

model MatchMap {
  id         String @id @default(uuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id])
  mapName    String
  scoreTeam1 Int    @default(0)
  scoreTeam2 Int    @default(0)
}

model PlayerMatchStats {
  id        String @id @default(uuid())
  matchId   String
  match     Match  @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player @relation(fields: [playerId], references: [id])
  agent     String
  acs       Int
  kills     Int
  deaths    Int
  assists   Int
  adr       Float
  hsPercent String
}
